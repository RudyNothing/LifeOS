<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/addTransactionRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lifeos_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Transaction"
            android:textColor="@color/lifeos_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Record your income or expenses."
            android:textColor="@color/lifeos_muted"
            android:textSize="15sp" />

        <Button
            android:id="@+id/buttonCancelTransaction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="← Back"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Transaction Type"
            android:textColor="@color/lifeos_text"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radioTransactionType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/radioIncome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Income" />

            <RadioButton
                android:id="@+id/radioExpense"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="Expense" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Transaction Title"
            android:textColor="@color/lifeos_text"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editTransactionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. Monthly Salary"
            android:inputType="textCapSentences"
            android:padding="12dp"
            android:background="@drawable/bg_lifeos_input" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Amount (₹)"
            android:textColor="@color/lifeos_text"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editTransactionAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter amount"
            android:inputType="numberDecimal"
            android:padding="12dp"
            android:background="@drawable/bg_lifeos_input" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Category"
            android:textColor="@color/lifeos_text"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerTransactionCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_lifeos_input"
            android:padding="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Date"
            android:textColor="@color/lifeos_text"
            android:textStyle="bold" />

        <Button
            android:id="@+id/buttonTransactionDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Select Date"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Payment Method"
            android:textColor="@color/lifeos_text"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerPaymentMethod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_lifeos_input"
            android:padding="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Description (Optional)"
            android:textColor="@color/lifeos_text"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editTransactionDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Add some details..."
            android:gravity="top"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="3"
            android:padding="12dp"
            android:background="@drawable/bg_lifeos_input" />

        <Button
            android:id="@+id/buttonSaveTransaction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="20dp"
            android:text="Save Transaction"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>

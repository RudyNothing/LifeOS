<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lifeos_background"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp">


        <Button
            android:id="@+id/buttonBackToDashboard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Dashboard"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LifeOS"
            android:textColor="@color/lifeos_text"
            android:textSize="32sp"
            android:textStyle="bold"
            android:letterSpacing="-0.03" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Make room for what matters."
            android:textColor="@color/lifeos_muted"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/bg_lifeos_card">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Create a task"
                android:textColor="@color/lifeos_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editTaskTitle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_lifeos_input"
                android:hint="What needs to get done?"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/lifeos_text"
                android:textColorHint="@color/lifeos_muted"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/editTaskDescription"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_lifeos_input"
                android:gravity="top|start"
                android:hint="Add a little detail..."
                android:inputType="textCapSentences|textMultiLine"
                android:padding="14dp"
                android:textColor="@color/lifeos_text"
                android:textColorHint="@color/lifeos_muted"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="CATEGORY"
                android:textColor="@color/lifeos_muted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/spinnerTaskCategory"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_selector_control"
                android:gravity="center_vertical"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:textColor="@color/lifeos_text"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="PRIORITY"
                android:textColor="@color/lifeos_muted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/spinnerTaskPriority"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_selector_control"
                android:gravity="center_vertical"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:textColor="@color/lifeos_text"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textSelectedDueDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="No due date"
                    android:textColor="@color/lifeos_muted"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/buttonSelectDueDate"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text=" + Date "
                    android:textAllCaps="false"
                    android:textSize="13sp" />

            </LinearLayout>

            <Button
                android:id="@+id/buttonAddTask"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="Add task  +"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Your tasks"
                android:textColor="@color/lifeos_text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textTaskCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 tasks"
                android:textColor="@color/lifeos_muted"
                android:textSize="13sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/textEmptyTasks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_lifeos_card"
            android:gravity="center"
            android:padding="24dp"
            android:text="Nothing on your list yet.\nAdd a task to get started."
            android:textColor="@color/lifeos_muted"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/taskListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>

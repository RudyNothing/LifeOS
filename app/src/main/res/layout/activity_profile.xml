<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/profileRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lifeos_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/buttonProfileBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_profile_icon_button"
                android:contentDescription="Back"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/lifeos_text"
                android:textSize="32sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LIFEOS / PERSONAL"
                    android:textColor="@color/lifeos_primary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your profile"
                    android:textColor="@color/lifeos_text"
                    android:textSize="23sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_profile_icon_button"
                android:gravity="center"
                android:text="✦"
                android:textColor="@color/lifeos_primary"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:id="@+id/textProfileHeading"
            android:text="MAKE IT\nPERSONAL."
            android:textColor="@color/lifeos_text"
            android:textSize="34sp"
            android:textStyle="bold"
            android:letterSpacing="-0.035" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Your space. Your details. Your way."
            android:id="@+id/textProfileSubtitle"
            android:textColor="@color/lifeos_muted"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_profile_hero"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="22dp">

            <FrameLayout
                android:id="@+id/profileAvatarArea"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:background="@drawable/bg_profile_avatar"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/imageProfile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/textProfileInitials"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="＋"
                    android:textColor="#FFFFFF"
                    android:textSize="38sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="YOUR IDENTITY"
                android:textColor="#E9E0FF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.16" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Make LifeOS yours"
                android:id="@+id/textProfileIdentity"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/buttonChangePhoto"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_profile_photo_button"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="17dp"
                android:paddingEnd="17dp"
                android:text="Change photo"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="23dp"
            android:background="@drawable/bg_lifeos_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="The essentials"
                android:textColor="@color/lifeos_text"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="A few details to make your workspace feel like home."
                android:textColor="@color/lifeos_muted"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="DISPLAY NAME"
                android:textColor="@color/lifeos_muted"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <EditText
                android:id="@+id/editProfileName"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_lifeos_input"
                android:hint="What should we call you?"
                android:inputType="textCapWords"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/lifeos_text"
                android:textColorHint="@color/lifeos_muted"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="EMAIL ADDRESS"
                android:textColor="@color/lifeos_muted"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <EditText
                android:id="@+id/editProfileEmail"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_lifeos_input"
                android:hint="you@example.com"
                android:inputType="textEmailAddress"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/lifeos_text"
                android:textColorHint="@color/lifeos_muted"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textColor="@color/lifeos_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.14" />


<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@drawable/bg_lifeos_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/textTransactionDialogEyebrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MONEY MANAGEMENT"
            android:textColor="@color/lifeos_muted"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:id="@+id/textTransactionDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Add Transaction"
            android:textColor="@color/lifeos_text"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Transaction type"
            android:textColor="@color/lifeos_text"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radioDialogTransactionType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioDialogIncome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="Income"
                android:textColor="@color/lifeos_text" />

            <RadioButton
                android:id="@+id/radioDialogExpense"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Expense"
                android:textColor="@color/lifeos_text" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Transaction title"
            android:textColor="@color/lifeos_text"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editDialogTransactionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_lifeos_input"
            android:hint="e.g. Monthly Salary"
            android:inputType="textCapSentences"
            android:padding="13dp"
            android:textColor="@color/lifeos_text"
            android:textColorHint="@color/lifeos_muted" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Amount (₹)"
            android:textColor="@color/lifeos_text"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editDialogTransactionAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_lifeos_input"
            android:hint="Enter amount"
            android:inputType="numberDecimal"
            android:padding="13dp"
            android:textColor="@color/lifeos_text"
            android:textColorHint="@color/lifeos_muted" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Category"
            android:textColor="@color/lifeos_text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textDialogTransactionCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_lifeos_input"
            android:drawableEnd="@android:drawable/arrow_down_float"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:padding="13dp"
            android:text="Select category"
            android:textColor="@color/lifeos_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Date"
            android:textColor="@color/lifeos_text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textDialogTransactionDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_lifeos_input"
            android:drawableEnd="@android:drawable/ic_menu_my_calendar"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:padding="13dp"
            android:text="Select date"
            android:textColor="@color/lifeos_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Payment method"
            android:textColor="@color/lifeos_text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textDialogPaymentMethod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_lifeos_input"
            android:drawableEnd="@android:drawable/arrow_down_float"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:padding="13dp"
            android:text="Select payment method"
            android:textColor="@color/lifeos_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Description (optional)"
            android:textColor="@color/lifeos_text"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editDialogTransactionDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_lifeos_input"
            android:gravity="top"
            android:hint="Add some details..."
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="3"
            android:padding="13dp"
            android:textColor="@color/lifeos_text"
            android:textColorHint="@color/lifeos_muted" />

        <Button
            android:id="@+id/buttonDialogSaveTransaction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Save Transaction"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/buttonDialogCancelTransaction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Cancel"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>

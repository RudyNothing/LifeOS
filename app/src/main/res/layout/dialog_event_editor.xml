<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@drawable/bg_dialog_surface"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:id="@+id/textEventDialogEyebrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LIFEOS / SCHEDULE"
            android:textColor="@color/lifeos_primary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <TextView
            android:id="@+id/textEventDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Create an event"
            android:textColor="@color/lifeos_text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Add the details and make it happen."
            android:textColor="@color/lifeos_muted"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/editEventTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_lifeos_input"
            android:hint="Event title"
            android:inputType="textCapSentences"
            android:padding="14dp"
            android:textColor="@color/lifeos_text"
            android:textColorHint="@color/lifeos_muted" />

        <EditText
            android:id="@+id/editEventDescription"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_lifeos_input"
            android:gravity="top"
            android:hint="Description (optional)"
            android:inputType="textCapSentences|textMultiLine"
            android:padding="14dp"
            android:textColor="@color/lifeos_text"
            android:textColorHint="@color/lifeos_muted" />

        <EditText
            android:id="@+id/editEventLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_lifeos_input"
            android:hint="Location (optional)"
            android:inputType="textCapSentences"
            android:padding="14dp"
            android:textColor="@color/lifeos_text"
            android:textColorHint="@color/lifeos_muted" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="CATEGORY"
            android:textColor="@color/lifeos_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textEventCategory"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_lifeos_input"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Personal     ▾"
            android:textColor="@color/lifeos_text"
            android:textSize="14sp" />

        <CheckBox
            android:id="@+id/checkEventAllDay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="This is an all-day event"
            android:textColor="@color/lifeos_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="START"
            android:textColor="@color/lifeos_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/buttonEventStart"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_lifeos_input"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Choose start date and time"
            android:textColor="@color/lifeos_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/textEventStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="No start time selected"
            android:textColor="@color/lifeos_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="END"
            android:textColor="@color/lifeos_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/buttonEventEnd"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_lifeos_input"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Choose end date and time"
            android:textColor="@color/lifeos_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/textEventEnd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="No end time selected"
            android:textColor="@color/lifeos_muted"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/checkEventReminder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:text="Remind me about this event"
            android:textColor="@color/lifeos_text" />

        <TextView
            android:id="@+id/buttonEventReminder"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_lifeos_input"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Choose reminder date and time"
            android:textColor="@color/lifeos_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/textEventReminder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="No reminder set"
            android:textColor="@color/lifeos_muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/buttonSaveEvent"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_profile_photo_button"
            android:text="Save event"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/buttonCancelEventEdit"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="7dp"
            android:backgroundTint="@android:color/transparent"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="@color/lifeos_muted" />

    </LinearLayout>
</ScrollView>
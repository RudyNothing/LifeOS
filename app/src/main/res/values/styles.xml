<resources>
    <style name="LifeOSButton" parent="@android:style/Widget.Material.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:backgroundTint">@color/lifeos_primary</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="LifeOSEditText" parent="@android:style/Widget.Material.EditText">
        <item name="android:textColor">@color/lifeos_text</item>
        <item name="android:textColorHint">@color/lifeos_muted</item>
        <item name="android:padding">14dp</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="LifeOSSpinner" parent="@android:style/Widget.Material.Spinner">
        <item name="android:popupBackground">@color/lifeos_surface</item>
    </style>

    <style name="LifeOSCheckBox" parent="@android:style/Widget.Material.CompoundButton.CheckBox">
        <item name="android:textColor">@color/lifeos_text</item>
        <item name="android:buttonTint">@color/lifeos_primary</item>
    </style>

    <style name="LifeOSRadioButton" parent="@android:style/Widget.Material.CompoundButton.RadioButton">
        <item name="android:textColor">@color/lifeos_text</item>
        <item name="android:buttonTint">@color/lifeos_primary</item>
    </style>
    <style name="LifeOSAlertDialog" parent="Theme.Material3.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog_surface</item>
        <item name="android:colorAccent">@color/lifeos_primary</item>
        <item name="colorPrimary">@color/lifeos_primary</item>
        <item name="colorSecondary">@color/lifeos_primary</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lifeos_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Privacy Corner"
            android:textColor="@color/lifeos_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Your private information, protected locally."
            android:textColor="@color/lifeos_muted"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/layoutPin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_lifeos_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/textPinHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Secure Vault"
                android:textColor="@color/lifeos_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textPinDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Set up a PIN to protect your vault."
                android:textColor="@color/lifeos_muted"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/editPin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_lifeos_input"
                android:hint="Enter 4–6 digit PIN"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:padding="14dp"
                android:textColor="@color/lifeos_text"
                android:textColorHint="@color/lifeos_muted" />

            <EditText
                android:id="@+id/editConfirmPin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_lifeos_input"
                android:hint="Confirm PIN"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:padding="14dp"
                android:textColor="@color/lifeos_text"
                android:textColorHint="@color/lifeos_muted"
                android:visibility="gone" />

            <Button
                android:id="@+id/buttonUnlockVault"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:text="Set PIN"
                android:textAllCaps="false" />

            <TextView
                android:id="@+id/textPinError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="#D32F2F"
                android:textSize="13sp"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutVault"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your Secure Records"
                android:textColor="@color/lifeos_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/buttonAddVaultItem"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="+ Add Secure Record"
                android:textAllCaps="false" />

            <TextView
                android:id="@+id/textVaultEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="No secure records yet."
                android:textColor="@color/lifeos_muted"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/layoutVaultItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

        </LinearLayout>

        <Button
            android:id="@+id/buttonPrivacyBack"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:text="Back to Dashboard"
            android:textAllCaps="false" />

    </LinearLayout>

</ScrollView>
